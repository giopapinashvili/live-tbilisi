# ─────────────────────────────────────────────────────────────
#  თბილისი LIVE — გარემოს ცვლადები
#  დააკოპირე ეს ფაილი `.env`-ად და შეავსე რეალური მნიშვნელობებით.
#  `.env` .gitignore-შია და არასდროს უნდა მოხვდეს repo-ში.
# ─────────────────────────────────────────────────────────────

# --- საიტის მისამართი (canonical და og:url ტეგებისთვის) ---
# ლოკალურად შეიძლება ცარიელი დარჩეს — მაშინ location.origin გამოიყენება.
VITE_SITE_URL=

# --- Firebase (Console → Project settings → Your apps → Web app) ---
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_APP_ID=
# არასავალდებულო
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_MEASUREMENT_ID=

# --- რუკის ტაილები ---
# რეჟიმი: pmtiles | maptiler | osm
#   pmtiles  — რეკომენდებული პროდაქშენისთვის (R2-ზე ატვირთული .pmtiles ფაილი)
#   maptiler — MapTiler-ის უფასო tier (100k tile/თვე)
#   osm      — მხოლოდ დეველოპმენტისთვის. OSM-ის tile usage policy კრძალავს
#              მაღალტრაფიკიან გამოყენებას, პროდაქშენში არ გამოიყენო.
VITE_TILES_MODE=osm
VITE_PMTILES_URL=
VITE_MAPTILER_KEY=

# --- Read plane (სტატიკური ბანდლები) ---
# ცარიელი = ლოკალური /bundles. პროდაქშენში R2-ის public URL.
VITE_BUNDLE_BASE=/bundles

# --- Meilisearch (ფაზა 2, ჯერ არასავალდებულო) ---
VITE_MEILI_HOST=
VITE_MEILI_SEARCH_KEY=

# ─────────────────────────────────────────────────────────────
#  მხოლოდ სერვერული სკრიპტებისთვის (scripts/*.mjs) — VITE_ პრეფიქსის გარეშე,
#  ანუ ბრაუზერში არასდროს ხვდება.
# ─────────────────────────────────────────────────────────────
# firebase-admin-ის service account JSON-ის გზა
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FB_PROJECT_ID=

# Overpass API endpoint (OSM იმპორტისთვის)
OVERPASS_URL=https://overpass-api.de/api/interpreter
