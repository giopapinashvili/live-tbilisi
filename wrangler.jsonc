{
  // ────────────────────────────────────────────────────────────
  //  Cloudflare Workers — სტატიკური ასეტები
  //
  //  ეს კონფიგი საჭიროა, თუ პროექტი Worker-ად შეიქმნა
  //  (deploy command: `npx wrangler deploy`).
  //  Pages-ის პროექტს ეს ფაილი არ სჭირდება — იქ მხოლოდ
  //  build command `npm run build` და output `dist` ივსება.
  //
  //  სერვერული კოდი არ გვაქვს: `main` განზრახ არაა მითითებული,
  //  ანუ Worker მხოლოდ სტატიკურ ფაილებს არიგებს.
  // ────────────────────────────────────────────────────────────

  "name": "live-tbilisi",
  "compatibility_date": "2026-08-01",

  // ბილდი აქედან ეშვება, deploy-ამდე. ეს განზრახ repo-შია და არა
  // Cloudflare-ის პანელში: თუ დაშბორდის „Build command" ცარიელია,
  // deploy მაინც იმუშავებს და კონფიგურაცია ერთ ადგილას რჩება.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    "directory": "./dist",

    // უცნობი მისამართი → 404.html (და არა ცარიელი პასუხი)
    "not_found_handling": "404-page",

    // /map → map.html ავტომატურად, ფაილის გაფართოების გარეშე.
    //
    // ⚠ სწორედ ამიტომ არ არსებობს `public/_redirects`.
    //    Workers static assets-ზე `_redirects` მხოლოდ ნამდვილ
    //    გადამისამართებებს იღებს — 200 („rewrite") არ მუშაობს და
    //    ჩვეულებრივ გადამისამართებად ითარგმნება. წესი `/map → /map.html`
    //    ამ პარამეტრთან ერთად უსასრულო მარყუჟს ქმნიდა:
    //    /map → /map.html → /map → …
    //    შედეგად გვერდი საერთოდ არ იხსნებოდა.
    //
    //    /b/{slug} და /c/{cat} ლამაზი მისამართები ნამდვილ Worker-ს
    //    მოითხოვს (ფაზა 2, SSR-თან ერთად) — სტატიკური ფაილებით არ გამოვა.
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }
}
