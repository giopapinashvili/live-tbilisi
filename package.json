{
  "name": "tbilisi-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "თბილისი LIVE — ქალაქის ერთიანი ციფრული რუკა",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "seed:taxonomy": "node scripts/seed-taxonomy.mjs",
    "import:osm": "node scripts/osm-import.mjs",
    "build:bundles": "node scripts/build-bundles.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "node scripts/selftest.mjs && node scripts/domtest.mjs && node scripts/styletest.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "geofire-common": "^6.0.0",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^20.4.0",
    "firebase-admin": "^13.0.2",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
