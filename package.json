{
  "name": "tbilisi-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "თბილისი LIVE — ქალაქის ერთიანი ციფრული რუკა",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "import:osm": "node scripts/osm-import.mjs",
    "build:bundles": "node scripts/build-bundles.mjs",
    "test": "node scripts/importtest.mjs && node scripts/selftest.mjs && node scripts/domtest.mjs && node scripts/styletest.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "test-data": "node scripts/build-test-data.mjs",
    "test-data:clean": "node scripts/build-test-data.mjs --clean"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^20.4.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
